# ── Application ──────────────────────────────────────────────
# Must be 8080 for docker-compose.yml (maps host 3001 -> container 8080).
# Use 3000 for bun run dev.
PORT=8080
NODE_ENV=production

# Required, at least 32 characters: the server refuses to start otherwise.
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-random-64-char-secret

# ── Database: homelab shared-postgres (default) ──────────────
DATABASE_URL=postgresql://group_checklist_app:change-me@shared-postgres:5432/group_checklist
DB_SSL=disable

# ── Database: local dev ──────────────────────────────────────
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/group_checklist
# DB_SSL=disable

# ── Database: managed Postgres (Neon, RDS, ...) ──────────────
# DATABASE_URL=postgresql://user:password@host/dbname
# DB_SSL=prefer     # or "require"
